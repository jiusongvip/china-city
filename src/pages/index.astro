---
import '@fontsource-variable/outfit';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { cities } from '../data/cities';
import {
  firstPick,
  routes,
  months,
  faqs,
  prepItems,
  trustSignals,
  budgetSummary,
  popularComparisons,
  travelerTypes,
  decisionRules,
  quickFacts,
} from '../data/content';

const hero = {
  cn: '中国',
  en: 'China City Guide',
  image: '/images/hero-great-wall.webp',
};

const canonicalUrl = new URL(Astro.url.pathname || '/', Astro.site).href;

// 所有城市均有独立指南页：卡片/表格链接直接指向独立页
const cityHref = (citySlug: string) => `/cities/${citySlug}/`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'China City Explorer',
  url: canonicalUrl,
  description:
    'Compare Chinese cities by travel style, budget, season, and high-speed rail to plan the right China trip.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const cityListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Top Chinese cities to visit',
  numberOfItems: cities.length,
  itemListElement: cities.map((city, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: city.name,
    url: `https://www.china-city.com/cities/${city.slug}/`,
    image: `https://www.china-city.com${city.image}`,
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'China City Guide 2026: Compare & Plan the Best Cities',
  description:
    'A decision tool for choosing Chinese cities by travel style, budget, season, and high-speed rail, with itineraries, costs, and visa tips.',
  datePublished: '2026-08-17',
  dateModified: trustSignals.lastUpdatedISO,
  image: 'https://www.china-city.com/images/og-china-city.webp',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: trustSignals.author,
  },
  publisher: {
    '@type': 'Organization',
    name: trustSignals.author,
    url: 'https://www.china-city.com',
  },
};

const destinationsSchema = {
  '@context': 'https://schema.org',
  '@graph': cities.map((city) => ({
    '@type': 'TouristDestination',
    name: `${city.name}, China`,
    description: city.why,
    url: `https://www.china-city.com/cities/${city.slug}/`,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: city.coords[1],
      longitude: city.coords[0],
    },
    containsPlace: city.attractions.map((a) => ({
      '@type': 'TouristAttraction',
      name: a.name,
      description: a.note,
    })),
  })),
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'China City Explorer',
  url: canonicalUrl,
  logo: {
    '@type': 'ImageObject',
    url: 'https://www.china-city.com/favicon.svg',
  },
  description:
    'A decision tool for choosing Chinese cities by travel style, budget, season, and high-speed rail.',
};

const compareData = cities.map((c) => ({
  slug: c.slug,
  name: c.name,
  bestFor: c.bestFor,
  topAttraction: c.topAttraction,
  food: c.food,
  bestMonths: c.bestMonths,
  budget: c.budget,
  verdict: c.verdict,
}));

// A-Z 城市索引：记录每个首字母第一次出现的行，用于锚点跳转
const cityInitials = cities.map((c) => c.name.charAt(0).toUpperCase());
const firstRowByInitial: Record<string, number> = {};
cityInitials.forEach((letter, i) => {
  if (!(letter in firstRowByInitial)) firstRowByInitial[letter] = i;
});
const initials = Object.keys(firstRowByInitial).sort();

const labelOffsets: Record<string, { dx: number; dy: number; anchor: string }> = {
  Suzhou: { dx: 0, dy: -8, anchor: 'middle' },
  Hangzhou: { dx: 0, dy: 16, anchor: 'middle' },
  Nanjing: { dx: -7, dy: 4, anchor: 'end' },
  'Xi\u2019an': { dx: 0, dy: -9, anchor: 'middle' },
  Chongqing: { dx: 0, dy: 16, anchor: 'middle' },
  Guilin: { dx: -7, dy: 4, anchor: 'end' },
  Yangshuo: { dx: 7, dy: 4, anchor: 'start' },
};

// 长三角三城地理上极近，在地图上适度分散，避免连线被城市点覆盖
const coordOffsets: Record<string, [number, number]> = {
  Suzhou: [-14, -22],
  Hangzhou: [-16, 16],
  Nanjing: [-12, -8],
};

function cityPoint(slug: string) {
  const city = cities.find((c) => c.slug === slug)!;
  const [lng, lat] = city.coords;
  const [ox, oy] = coordOffsets[city.name] || [0, 0];
  return {
    x: Math.round((lng - 73) * 10) + ox,
    y: Math.round((54 - lat) * 10) + oy,
  };
}

const mapPoints = cities.map((city) => {
  const pt = cityPoint(city.slug);
  const off = labelOffsets[city.name] || { dx: 7, dy: 4, anchor: 'start' };
  return {
    name: city.name,
    x: pt.x,
    y: pt.y,
    dx: off.dx,
    dy: off.dy,
    anchor: off.anchor,
  };
});

const mapRoutes = [
  { slugs: ['beijing', 'xian', 'chengdu', 'guilin', 'hong-kong'], color: '#4527a0', opacity: 0.7 },
  { slugs: ['shanghai', 'suzhou', 'hangzhou'], color: '#1e3a8a', opacity: 1 },
  { slugs: ['beijing', 'xian', 'chengdu'], color: '#c83c2d', opacity: 1 },
].map((route) => ({
  color: route.color,
  opacity: route.opacity,
  points: route.slugs
    .map((slug) => {
      const pt = cityPoint(slug);
      return `${pt.x},${pt.y}`;
    })
    .join(' '),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>China City Guide 2026: Compare & Plan the Best Cities</title>
    <meta
      name="description"
      content="Find your perfect Chinese city. Compare top cities by travel style, budget, season, and high-speed rail. Get city guides, itineraries, costs, and visa tips."
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="https://www.china-city.com/sitemap.xml" />
    <link rel="preload" as="image" href="/images/hero-great-wall.webp" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="China City Guide 2026: Compare & Plan the Best Cities" />
    <meta property="og:description" content="Compare Chinese cities by travel style, budget, season, and high-speed rail to plan the right China trip." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.china-city.com/images/og-china-city.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="China City Explorer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.china-city.com/images/og-china-city.webp" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(cityListSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(destinationsSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-[#d9d8d2] bg-[#f7f7f4]/90 backdrop-blur">
      <div class="page-shell flex h-20 items-center justify-between gap-4">
        <a href="#top" class="flex items-center gap-2 text-base font-bold tracking-[-0.02em]">
          <span class="grid size-9 place-items-center rounded-full bg-[#c83c2d] text-sm text-[#f7f7f4]">C</span>
          <span>China City Explorer</span>
        </a>
        <nav aria-label="Main navigation" class="hidden items-center gap-5 text-sm font-semibold text-[#6b6a65] md:flex">
          <a class="hover:text-[#161616]" href="#start">Start</a>
          <a class="hover:text-[#161616]" href="#find">Find</a>
          <a class="hover:text-[#161616]" href="#cities">Cities</a>
          <a class="hover:text-[#161616]" href="#compare">Compare</a>
          <a class="hover:text-[#161616]" href="#map">Map</a>
          <a class="hover:text-[#161616]" href="#routes">Routes</a>
          <a class="hover:text-[#161616]" href="#months">Months</a>
          <a class="hover:text-[#161616]" href="#faq">FAQ</a>
        </nav>
        <a class="btn-primary !min-h-10 !px-4 !py-2.5 text-sm md:hidden" href="#start">Start</a>
      </div>
    </header>

    <main id="top">
      <section class="section-pad pt-20 lg:pt-24">
        <div class="page-shell grid min-h-[calc(100dvh-5rem)] items-center gap-10 lg:grid-cols-[1.08fr_0.92fr]">
          <div class="max-w-[680px]">
            <p class="eyebrow mb-6">China city guide 2026</p>
            <h1 class="max-w-[720px] text-5xl md:text-7xl">
              Find the right Chinese city for your trip.
            </h1>
            <p class="mt-6 max-w-[560px] text-base leading-7 text-[#6b6a65] md:text-lg">
              First time? Start in Beijing. Compare cities by travel style, budget, season, and rail
              links, then build a route you can actually book.
            </p>
            <div class="mt-6 rounded-2xl border border-[#d9d8d2] bg-white p-4">
              <p class="text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">The short answer</p>
              <p class="mt-2 text-sm font-semibold leading-6">
                Start in <a href="#start" class="text-[#c83c2d] underline decoration-2 underline-offset-2">Beijing</a>
                &middot; 3 days &middot; $65&ndash;120/day &middot; best Apr, May, Sep, Oct
              </p>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <a class="btn-primary" href="#start">See the first-timer pick</a>
              <a class="btn-secondary" href="#find">Take the city quiz</a>
            </div>
          </div>
          <div class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl border border-[#d9d8d2]">
            <img
              src={hero.image}
              alt="The Great Wall of China snaking over green mountain ridges at sunrise"
              class="absolute inset-0 h-full w-full object-cover"
              fetchpriority="high"
              width="960"
              height="720"
            />
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white" style="background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.45) 100%);">
              <span class="text-[5rem] font-bold leading-none md:text-[7rem]" style="font-family:'Outfit Variable',system-ui,sans-serif;text-shadow:0 2px 30px rgba(0,0,0,0.5)">中国</span>
              <span class="mt-3 text-xs font-bold uppercase tracking-[0.32em]">{hero.en}</span>
            </div>
          </div>
        </div>
      </section>

      <nav id="toc" aria-label="On this page" class="border-t border-[#d9d8d2]">
        <div class="page-shell flex flex-wrap items-center gap-x-5 gap-y-2 py-4 text-sm font-semibold text-[#6b6a65]">
          <span class="mr-1 text-xs font-bold uppercase tracking-[0.08em]">On this page</span>
          <a class="hover:text-[#161616]" href="#start">First-timer pick</a>
          <a class="hover:text-[#161616]" href="#find">City match quiz</a>
          <a class="hover:text-[#161616]" href="#cities">City guides</a>
          <a class="hover:text-[#161616]" href="#compare">Compare</a>
          <a class="hover:text-[#161616]" href="#map">Map</a>
          <a class="hover:text-[#161616]" href="#routes">Routes</a>
          <a class="hover:text-[#161616]" href="#months">Months</a>
          <a class="hover:text-[#161616]" href="#faq">FAQ</a>
        </div>
      </nav>

      <section id="start" class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-stretch">
          <div class="card overflow-hidden">
            <img src="/images/beijing-forbidden-city.webp" alt="The Forbidden City in Beijing with red walls and golden roofs at sunrise" class="aspect-[4/3] h-full w-full object-cover" width="640" height="480" />
          </div>
          <div class="card p-6 md:p-8">
            <p class="eyebrow mb-6">The verdict</p>
            <h2 class="text-3xl md:text-4xl">{firstPick.headline}</h2>
            <p class="mt-4 text-base leading-7 text-[#6b6a65]">{firstPick.summary}</p>
            <ul class="mt-6 grid gap-3">
              {firstPick.reasons.map((reason) => (
                <li class="flex gap-3 text-sm leading-6">
                  <span class="mt-1 size-2 shrink-0 rounded-full bg-[#c83c2d]"></span>
                  <span>{reason}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 rounded-2xl bg-[#161616] p-5 text-[#f7f7f4]">
              <p class="text-xs font-bold uppercase tracking-[0.08em] text-[#f7f7f4]/60">A realistic 3-day start</p>
              <ol class="mt-3 grid gap-2 text-sm leading-6">
                {firstPick.itinerary.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
            <div class="mt-6 grid gap-3 border-t border-[#d9d8d2] pt-5">
              <p class="text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Not your style? Start here instead</p>
              {firstPick.alternatives.map((alt) => (
                <p class="text-sm leading-6"><strong>{alt.city}:</strong> {alt.reason}</p>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell">
          <div class="mb-8 max-w-[720px]">
            <p class="eyebrow mb-6">Quick decisions</p>
            <h2 class="text-4xl md:text-5xl">If this, then that.</h2>
            <p class="mt-5 max-w-[620px] text-base leading-7 text-[#6b6a65]">
              Six fast rules for the most common "it depends" questions.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {decisionRules.map((rule) => (
              <div class="card p-5">
                <p class="text-sm font-semibold text-[#6b6a65]">{rule.condition}</p>
                <p class="mt-2 text-base font-bold">{rule.result}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell">
          <div class="mb-8 max-w-[720px]">
            <p class="eyebrow mb-6">Pick your style</p>
            <h2 class="text-4xl md:text-5xl">Start with who you are.</h2>
            <p class="mt-5 max-w-[620px] text-base leading-7 text-[#6b6a65]">
              Six traveler types, each with a city combo that fits.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {travelerTypes.map((type) => (
              <div class="card p-5">
                <p class="text-base font-bold">{type.label}</p>
                <p class="mt-2 text-sm font-semibold text-[#c83c2d]">{type.cities}</p>
                <p class="mt-2 text-sm leading-6 text-[#6b6a65]">{type.reason}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="find" class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="eyebrow mb-6">City match</p>
            <h2 class="text-4xl md:text-5xl">Answer five filters to see a city match.</h2>
            <p class="mt-5 max-w-[560px] text-base leading-7 text-[#6b6a65]">
              Use your travel style, budget, season, and trip length to get a clearer starting point.
            </p>
          </div>

          <form id="quiz-form" class="card p-5 md:p-7">
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Travel style</span>
                <select name="style" class="w-full rounded-xl border border-[#d9d8d2] bg-white px-3 py-3 text-sm font-semibold text-[#161616]">
                  <option value="history">History</option>
                  <option value="food">Food</option>
                  <option value="modern">Modern city</option>
                  <option value="nature">Nature</option>
                  <option value="photography">Photography</option>
                  <option value="family">Family</option>
                </select>
              </label>
              <label class="block">
                <span class="mb-2 block text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Daily budget</span>
                <select name="budget" class="w-full rounded-xl border border-[#d9d8d2] bg-white px-3 py-3 text-sm font-semibold text-[#161616]">
                  <option value="low">Under $60</option>
                  <option value="mid">$60 to $120</option>
                  <option value="high">Over $120</option>
                </select>
              </label>
              <label class="block">
                <span class="mb-2 block text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Trip length</span>
                <select name="days" class="w-full rounded-xl border border-[#d9d8d2] bg-white px-3 py-3 text-sm font-semibold text-[#161616]">
                  <option value="short">3 to 5 days</option>
                  <option value="medium">6 to 9 days</option>
                  <option value="long">10 or more days</option>
                </select>
              </label>
              <label class="block">
                <span class="mb-2 block text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Season</span>
                <select name="season" class="w-full rounded-xl border border-[#d9d8d2] bg-white px-3 py-3 text-sm font-semibold text-[#161616]">
                  <option value="spring">Spring</option>
                  <option value="summer">Summer</option>
                  <option value="autumn">Autumn</option>
                  <option value="winter">Winter</option>
                </select>
              </label>
              <label class="block sm:col-span-2">
                <span class="mb-2 block text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Who is traveling</span>
                <select name="who" class="w-full rounded-xl border border-[#d9d8d2] bg-white px-3 py-3 text-sm font-semibold text-[#161616]">
                  <option value="solo">Solo</option>
                  <option value="couple">Couple</option>
                  <option value="family">Family</option>
                </select>
              </label>
            </div>
            <button type="submit" class="btn-primary mt-5 w-full sm:w-auto">Show my city match</button>

            <div id="quiz-result" class="mt-6 hidden rounded-2xl border border-[#c83c2d]/30 bg-[#c83c2d]/5 p-5">
              <p id="quiz-result-title" class="text-xl font-bold tracking-[-0.02em]"></p>
              <p id="quiz-result-reason" class="mt-2 text-sm leading-6 text-[#6b6a65]"></p>
              <p id="quiz-result-alt" class="mt-3 text-sm font-semibold"></p>
            </div>
          </form>
        </div>
      </section>

      <section id="cities" class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell">
          <div class="mb-8 max-w-[720px]">
            <p class="eyebrow mb-6">City index</p>
            <h2 class="text-4xl md:text-5xl">Filter Chinese cities by what you actually want.</h2>
            <p class="mt-5 max-w-[620px] text-base leading-7 text-[#6b6a65]">
              Start with a travel mood, then narrow by best months and daily budget. Pick any card to
              open its full guide: attractions, a day-by-day plan, food, and getting around.
            </p>
          </div>

          <div class="mb-7 flex flex-wrap gap-2">
            <button data-filter="all" class="rounded-full border border-[#161616] bg-[#161616] px-4 py-2 text-xs font-bold text-[#f7f7f4]">All</button>
            <button data-filter="history" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">History</button>
            <button data-filter="food" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Food</button>
            <button data-filter="modern" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Modern</button>
            <button data-filter="nature" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Nature</button>
            <button data-filter="photography" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Photography</button>
            <button data-filter="family" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Family</button>
            <button data-filter="winter" class="rounded-full border border-[#d9d8d2] bg-white px-4 py-2 text-xs font-bold text-[#161616]">Winter</button>
          </div>

          <div class="mb-7 flex flex-wrap items-center gap-2">
            <span class="mr-1 text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Skip cities if you</span>
            <button data-avoid="spicy" class="avoid-btn rounded-full border border-dashed border-[#c83c2d] bg-white px-4 py-2 text-xs font-bold text-[#c83c2d]">Dislike spicy food</button>
            <button data-avoid="cold" class="avoid-btn rounded-full border border-dashed border-[#c83c2d] bg-white px-4 py-2 text-xs font-bold text-[#c83c2d]">Hate the cold</button>
            <button data-avoid="heights" class="avoid-btn rounded-full border border-dashed border-[#c83c2d] bg-white px-4 py-2 text-xs font-bold text-[#c83c2d]">Fear heights</button>
            <button data-avoid="crowds" class="avoid-btn rounded-full border border-dashed border-[#c83c2d] bg-white px-4 py-2 text-xs font-bold text-[#c83c2d]">Avoid big crowds</button>
            <button data-avoid="altitude" class="avoid-btn rounded-full border border-dashed border-[#c83c2d] bg-white px-4 py-2 text-xs font-bold text-[#c83c2d]">Worry about altitude</button>
