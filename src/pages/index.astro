                <p class="mt-4 text-base leading-7 text-[#6b6a65]">{trustSignals.method}</p>
                <p class="mt-4 text-sm leading-6 text-[#6b6a65]">
                  Author: {trustSignals.author}. Last updated: {trustSignals.lastUpdated}.
                </p>
                <p class="mt-3 text-sm leading-6 text-[#6b6a65]">{trustSignals.authorBio}</p>
                <p class="mt-3 rounded-xl border border-[#d9d8d2] bg-white p-4 text-sm leading-6 text-[#6b6a65]">
                  {trustSignals.updateNote}
                </p>
                <p class="mt-3 text-sm leading-6 text-[#6b6a65]">
                  Spotted an outdated rail time or visa rule? Tell us and we will fix it.
                </p>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.08em] text-[#6b6a65]">Data sources</p>
                <ul class="mt-4 grid gap-2 text-sm leading-6">
                  {trustSignals.sources.map((source) => (
                    <li class="flex gap-3">
                      <span class="mt-1 size-2 shrink-0 rounded-full bg-[#c83c2d]"></span>
                      <a href={source.url} target="_blank" rel="noopener noreferrer nofollow" class="underline decoration-1 underline-offset-2 hover:text-[#c83c2d]">{source.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="privacy" class="section-pad border-t border-[#d9d8d2]">
        <div class="page-shell">
          <div class="mb-8 max-w-[720px]">
            <p class="eyebrow mb-6">Privacy</p>
            <h2 class="text-4xl md:text-5xl">No tracking, no sign-up.</h2>
          </div>
          <div class="card p-6 md:p-8">
            <p class="text-base leading-7 text-[#6b6a65]">
              This is a static reference page. It does not use cookies, run analytics scripts, collect personal data, or track your activity. The city match quiz and comparison tool run entirely in your browser, and nothing you enter is sent to a server or stored.
            </p>
            <p class="mt-4 text-sm leading-6 text-[#6b6a65]">
              If you spot an error or have a question, email <a href="mailto:hello@china-city.com" class="underline decoration-1 underline-offset-2 hover:text-[#c83c2d]">hello@china-city.com</a>.
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#d9d8d2] bg-[#161616] text-[#f7f7f4]">
      <div class="page-shell flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-lg font-bold tracking-[-0.02em]">China City Explorer</p>
          <p class="mt-2 max-w-[460px] text-sm leading-6 text-[#f7f7f4]/60">
            A single-page planning tool for choosing Chinese cities by travel style, budget, season,
            and rail access.
          </p>
        </div>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-[#f7f7f4]/70">
          <a class="hover:text-[#f7f7f4]" href="#start">Start</a>
          <a class="hover:text-[#f7f7f4]" href="#find">Find</a>
          <a class="hover:text-[#f7f7f4]" href="#cities">Cities</a>
          <a class="hover:text-[#f7f7f4]" href="#compare">Compare</a>
          <a class="hover:text-[#f7f7f4]" href="#routes">Routes</a>
          <a class="hover:text-[#f7f7f4]" href="#months">Months</a>
          <a class="hover:text-[#f7f7f4]" href="#privacy">Privacy</a>
        </nav>
      </div>
      <div class="page-shell border-t border-[#f7f7f4]/15 py-5 text-xs leading-5 text-[#f7f7f4]/45">
        Visa, train, weather, and price details change often. Confirm current rules with official
        sources before booking. This page does not sell tours or take commissions on tickets.
      </div>
    </footer>

    <script type="application/json" id="city-data" set:html={JSON.stringify(compareData)}></script>
    <script>
      const cityData = JSON.parse(document.getElementById('city-data')!.textContent!);

      const filterButtons = document.querySelectorAll<HTMLElement>('[data-filter]');
      const avoidButtons = document.querySelectorAll<HTMLElement>('.avoid-btn');
      const cityCards = document.querySelectorAll<HTMLElement>('.city-card');
      const cityEmpty = document.getElementById('city-empty')!;

      let activeFilter = 'all';
      const activeAvoid = new Set<string>();

      function applyCityFilters() {
        let visibleCount = 0;
        cityCards.forEach((card) => {
          const tags = (card.dataset.tags || '').split(' ');
          const avoid = (card.dataset.avoid || '').split(' ').filter(Boolean);
          const matchesFilter = activeFilter === 'all' || tags.includes(activeFilter);
          const matchesAvoid = [...activeAvoid].every((a) => !avoid.includes(a));
          const matches = matchesFilter && matchesAvoid;
          card.classList.toggle('hidden', !matches);
          if (matches) visibleCount += 1;
        });
        cityEmpty.classList.toggle('hidden', visibleCount !== 0);
      }

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter || 'all';
          filterButtons.forEach((item) => {
            item.classList.remove('bg-[#161616]', 'text-[#f7f7f4]');
            item.classList.add('bg-white', 'text-[#161616]');
          });
          button.classList.remove('bg-white', 'text-[#161616]');
          button.classList.add('bg-[#161616]', 'text-[#f7f7f4]');
          applyCityFilters();
        });
      });

      avoidButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.avoid || '';
          if (activeAvoid.has(key)) {
            activeAvoid.delete(key);
            button.classList.remove('bg-[#c83c2d]', 'text-[#f7f7f4]');
            button.classList.add('bg-white', 'text-[#c83c2d]');
          } else {
            activeAvoid.add(key);
            button.classList.remove('bg-white', 'text-[#c83c2d]');
            button.classList.add('bg-[#c83c2d]', 'text-[#f7f7f4]');
          }
          applyCityFilters();
        });
      });

      // 表格行点击 → 跳转到城市独立页（卡片本身是 <a> 链接，默认导航即可）
      document.querySelectorAll<HTMLElement>('.city-row').forEach((row) => {
        row.addEventListener('click', (event) => {
          const link = row.querySelector('a[href^="/cities/"]') as HTMLAnchorElement | null;
          if (!link) return;
          event.preventDefault();
          window.location.href = link.getAttribute('href') || '';
        });
      });

      const quizForm = document.getElementById('quiz-form') as HTMLFormElement;
      const quizResult = document.getElementById('quiz-result')!;
      const quizResultTitle = document.getElementById('quiz-result-title')!;
      const quizResultReason = document.getElementById('quiz-result-reason')!;
      const quizResultAlt = document.getElementById('quiz-result-alt')!;

      const styleSuggestions = {
        history: {
          city: "Xi'an",
          reason: "Xi'an gives you the Terracotta Army, a walkable city wall, and a stronger sense of ancient China without the larger scale of Beijing.",
          alternatives: ['Beijing', 'Nanjing'],
        },
        food: {
          city: 'Chengdu',
          reason: 'Chengdu is the best food-first city for first-time visitors, with deep local flavor, tea houses, pandas, and a more relaxed pace.',
          alternatives: ['Chongqing', 'Xi\u2019an'],
        },
        modern: {
          city: 'Shanghai',
          reason: 'Shanghai gives you the cleanest modern-city experience, with strong food, design, skyline views, and easy side trips.',
          alternatives: ['Hong Kong', 'Chongqing'],
        },
        nature: {
          city: 'Guilin',
          reason: 'Guilin is the easiest nature entry point because the Li River and karst scenery are close to town and simple to arrange.',
          alternatives: ['Zhangjiajie', 'Hangzhou'],
        },
        photography: {
          city: 'Zhangjiajie',
          reason: 'Zhangjiajie has the most visually distinct landscape for photography, with layered sandstone peaks and forested viewpoints.',
          alternatives: ['Guilin', 'Chongqing'],
        },
        family: {
          city: 'Beijing',
          reason: 'Beijing works well for families because the main landmarks are clear, walkable, and easy to pair with a slower second city.',
          alternatives: ['Chengdu', 'Hong Kong'],
        },
      };

      quizForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const form = new FormData(quizForm);
        const style = form.get('style') as keyof typeof styleSuggestions;
        const season = form.get('season') as string;
        const budget = form.get('budget') as string;
        const who = form.get('who') as string;
        let suggestion = styleSuggestions[style as keyof typeof styleSuggestions] || styleSuggestions.history;

        if (season === 'winter' && style !== 'food') {
          suggestion = {
            city: 'Harbin',
            reason: 'Harbin is the clearest winter pick when you want snow, ice architecture, and a completely different side of China.',
            alternatives: ['Beijing', 'Hong Kong'],
          };
        }

        if (who === 'family' && style !== 'history') {
          suggestion = {
            city: 'Chengdu',
            reason: 'Chengdu is easy for families because pandas, casual food, and a slower pace reduce the pressure of a packed itinerary.',
            alternatives: ['Beijing', 'Guilin'],
          };
        }

        if (budget === 'high' && style === 'modern') {
          suggestion = {
            city: 'Hong Kong',
            reason: 'Hong Kong is the strongest high-budget city pick when you want polished hotels, skyline views, and dense food culture.',
            alternatives: ['Shanghai', 'Beijing'],
          };
        }

        quizResultTitle.textContent = `Start with ${suggestion.city}.`;
        quizResultReason.textContent = suggestion.reason;
        quizResultAlt.textContent = `Good alternatives: ${suggestion.alternatives.join(', ')}.`;
        quizResult.classList.remove('hidden');
        quizResult.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      const compareForm = document.getElementById('compare-form')!;
      const compareA = document.getElementById('compare-a') as HTMLSelectElement;
      const compareB = document.getElementById('compare-b') as HTMLSelectElement;
      const fields = [
        ['bestFor', 'compare-a-best', 'compare-b-best'],
        ['topAttraction', 'compare-a-attraction', 'compare-b-attraction'],
        ['food', 'compare-a-food', 'compare-b-food'],
        ['bestMonths', 'compare-a-months', 'compare-b-months'],
        ['budget', 'compare-a-budget', 'compare-b-budget'],
        ['verdict', 'compare-a-verdict', 'compare-b-verdict'],
      ];

      function updateCompare(slugA: string, slugB: string) {
        const cityA = cityData.find((city: any) => city.slug === slugA);
        const cityB = cityData.find((city: any) => city.slug === slugB);
        if (!cityA || !cityB) return;
        document.getElementById('compare-a-name')!.textContent = cityA.name;
        document.getElementById('compare-b-name')!.textContent = cityB.name;
        fields.forEach(([field, leftId, rightId]) => {
          document.getElementById(leftId)!.textContent = cityA[field];
          document.getElementById(rightId)!.textContent = cityB[field];
        });
      }

      compareForm.addEventListener('submit', (event) => {
        event.preventDefault();
        updateCompare(compareA.value, compareB.value);
      });

      document.querySelectorAll<HTMLElement>('.compare-preset').forEach((button) => {
        button.addEventListener('click', () => {
          compareA.value = button.dataset.a!;
          compareB.value = button.dataset.b!;
          updateCompare(button.dataset.a!, button.dataset.b!);
          compareForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    </script>
  </body>
</html>
