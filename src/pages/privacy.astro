---
import '@fontsource-variable/outfit';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { trustSignals } from '../data/content';

const canonicalUrl = 'https://www.chinacitytravel.com/privacy/';
const title = 'Privacy Policy - China City Explorer';
const description =
  'Privacy policy for China City Explorer: what data the site collects, how Google Analytics 4 is used, cookies, and your choices.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="https://www.chinacitytravel.com/sitemap-index.xml" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://www.chinacitytravel.com/images/og-china-city.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.chinacitytravel.com/images/og-china-city.webp" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      url: canonicalUrl,
      description,
      isPartOf: {
        '@type': 'WebSite',
        name: 'China City Explorer',
        url: 'https://www.chinacitytravel.com',
      },
    })}></script>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-[#d9d8d2] bg-[#f7f7f4]/90 backdrop-blur">
      <div class="page-shell flex h-20 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 text-base font-bold tracking-[-0.02em]">
          <span class="grid size-9 place-items-center rounded-full bg-[#c83c2d] text-sm text-[#f7f7f4]">C</span>
          <span>China City Explorer</span>
        </a>
        <nav aria-label="Main navigation" class="hidden items-center gap-5 text-sm font-semibold text-[#6b6a65] md:flex">
          <a class="hover:text-[#161616]" href="/#cities">Cities</a>
          <a class="hover:text-[#161616]" href="/#compare">Compare</a>
          <a class="hover:text-[#161616]" href="/#routes">Routes</a>
          <a class="hover:text-[#161616]" href="/about/">About</a>
          <a class="hover:text-[#161616]" href="/#faq">FAQ</a>
        </nav>
        <a class="btn-primary !min-h-10 !px-4 !py-2.5 text-sm md:hidden" href="/#cities">Cities</a>
      </div>
    </header>

    <main>
      <section class="section-pad pt-14 lg:pt-20">
        <div class="page-shell max-w-[760px]">
          <p class="eyebrow mb-6">Privacy</p>
          <h1 class="text-5xl md:text-6xl">Privacy policy.</h1>
          <p class="mt-5 text-base leading-7 text-[#6b6a65] md:text-lg">
            This is a static reference site. We collect as little data as possible. Last updated:
            {trustSignals.lastUpdated}.
          </p>

          <div class="mt-10 grid gap-6">
            <div class="card p-6">
              <h2 class="text-2xl">What we do not collect.</h2>
              <p class="mt-4 text-base leading-7 text-[#6b6a65]">
                No accounts, no sign-ups, no forms that send data to a server. The city match quiz
                and comparison tool run entirely in your browser, and nothing you enter there is
                transmitted or stored. We never sell personal data.
              </p>
            </div>

            <div class="card p-6">
              <h2 class="text-2xl">Analytics.</h2>
              <p class="mt-4 text-base leading-7 text-[#6b6a65]">
                We use Google Analytics 4 to count anonymous, aggregated visits: which pages are
                viewed, in which country, and on which device type. GA4 does not log or store your
                IP address in our reports, and we do not use advertising features or cross-site
                tracking. Analytics loads only after you start interacting with the page.
              </p>
              <p class="mt-4 text-sm leading-6 text-[#6b6a65]">
                You can opt out with
                <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-[#c83c2d] underline decoration-2 underline-offset-2">Google's official opt-out add-on</a>
                or any standard ad blocker.
              </p>
            </div>

            <div class="card p-6">
              <h2 class="text-2xl">Cookies.</h2>
              <p class="mt-4 text-base leading-7 text-[#6b6a65]">
                This site sets no first-party cookies. Google Analytics may set its own measurement
                cookies, which you can clear or block at any time through your browser settings.
              </p>
            </div>

            <div class="card p-6">
              <h2 class="text-2xl">Email.</h2>
              <p class="mt-4 text-base leading-7 text-[#6b6a65]">
                If you email us, we use your address only to reply to your question or correction.
                We do not add you to any list or share your address.
              </p>
            </div>

            <div class="card p-6">
              <h2 class="text-2xl">Contact.</h2>
              <p class="mt-4 text-base leading-7 text-[#6b6a65]">
                Privacy questions? Email
                <a href="mailto:hello@chinacitytravel.com" class="text-[#c83c2d] underline decoration-2 underline-offset-2">hello@chinacitytravel.com</a>.
                See also our <a href="/terms/" class="text-[#c83c2d] underline decoration-2 underline-offset-2">terms of use</a>.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-[#d9d8d2] bg-[#161616] text-[#f7f7f4]">
      <div class="page-shell flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-lg font-bold tracking-[-0.02em]">China City Explorer</p>
          <p class="mt-2 max-w-[460px] text-sm leading-6 text-[#f7f7f4]/60">
            A planning tool for choosing Chinese cities by travel style, budget, season, and rail access.
          </p>
        </div>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold text-[#f7f7f4]/70">
          <a class="hover:text-[#f7f7f4]" href="/#cities">Cities</a>
          <a class="hover:text-[#f7f7f4]" href="/#compare">Compare</a>
          <a class="hover:text-[#f7f7f4]" href="/#routes">Routes</a>
          <a class="hover:text-[#f7f7f4]" href="/about/">About</a>
          <a class="hover:text-[#f7f7f4]" href="/privacy/">Privacy</a>
          <a class="hover:text-[#f7f7f4]" href="/terms/">Terms</a>
        </nav>
      </div>
      <div class="page-shell border-t border-[#f7f7f4]/15 py-5 text-xs leading-5 text-[#f7f7f4]/45">
        Visa, train, weather, and price details change often. Confirm current rules with official
        sources before booking. This page does not sell tours or take commissions on tickets.
      </div>
    </footer>
  </body>
</html>
